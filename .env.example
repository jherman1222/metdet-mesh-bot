# Copy to .env and fill in. Never commit .env.
# Or run: python -m bot.setup   (web or CLI wizard — prompts for these)
#
# To browse the Burning Man 2026 public archive only (no key needed):
#   python -m bot.archive

# tcp = Wi-Fi/Ethernet TCP API · usb = USB serial cable
MESHTASTIC_MODE=tcp
MESHTASTIC_HOST=127.0.0.1
MESHTASTIC_PORT=4403
# Used when MESHTASTIC_MODE=usb (e.g. /dev/ttyUSB0, /dev/cu.usbserial-…, COM3)
MESHTASTIC_SERIAL=

# Google AI Studio / Gemini API key — required
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Word users DM to unlock (change this for your camp)
UNLOCK_PASSPHRASE=metdet

# Comma-separated Meshtastic node IDs that skip unlock / identity gates
# Example: !aabbccdd,!11223344  (leave empty if none)
ADMIN_NODE_IDS=

# Admin web UI — keep on localhost unless you add your own auth/reverse proxy
ADMIN_HTTP_HOST=127.0.0.1
ADMIN_HTTP_PORT=8787

# LoRa DM packing (higher CHUNK_DELAY_SEC = better chance multi-part arrives in order)
MAX_CHUNK_CHARS=200
MAX_CHUNKS=3
CHUNK_DELAY_SEC=15
RATE_LIMIT_SECONDS=20

SYSTEM_PROMPT=You are METDET, a mesh radio helper. Answer using web search when facts may be time-sensitive. Keep answers extremely short: 1-3 tight sentences, no markdown, no bullets, no emojis. Prefer safety, weather, dust, power, and practical how-to.
